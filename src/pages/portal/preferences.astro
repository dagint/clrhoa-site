---
/**
 * User Preferences Page
 * Privacy settings and notification preferences
 */
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import PortalPage from '../../components/PortalPage.astro';
import { getPortalContext } from '../../lib/portal-context';
import { getPortalBadgeCounts } from '../../lib/portal-badge-counts';
import { getUserByEmail, type NotificationPreferences } from '../../lib/db';
import { getOwnerByEmail } from '../../lib/directory-db';
import { NOTIFICATION_TYPES } from '../../lib/notifications';

const { env, session, effectiveRole } = await getPortalContext(Astro);
if (!session) return Astro.redirect('/auth/login');

const { email, role, name } = session;
const db = env?.DB;
const badges = await getPortalBadgeCounts(db, email, role, name);

// Get user notification preferences
let sms_optin = false;
let notification_preferences: NotificationPreferences = {};
if (db) {
  const user = await getUserByEmail(db, email);
  if (user) {
    sms_optin = user.sms_optin === 1 || user.sms_optin === true;
    if (user.notification_preferences?.trim()) {
      try {
        notification_preferences = JSON.parse(user.notification_preferences) as NotificationPreferences;
      } catch {}
    }
  }
}

// Get owner privacy settings
const owner = db ? await getOwnerByEmail(db, email) : null;
const pushEnabled = notification_preferences['push_enabled'] === true;
---

<PortalLayout title="Preferences | Member Portal | Crooked Lake Reserve HOA">
  <PortalPage
    currentPath="/portal/preferences"
    pageTitle="Preferences"
    userName={badges.displayName ?? undefined}
    userEmail={email}
    effectiveRole={effectiveRole}
    draftCount={badges.draftCount}
    role={effectiveRole}
    staffRole={role ?? ''}
    arbInReviewCount={badges.arbInReviewCount}
    vendorPendingCount={badges.vendorPendingCount}
    maintenanceOpenCount={badges.maintenanceOpenCount}
    meetingsRsvpCount={badges.meetingsRsvpCount}
    feedbackDueCount={badges.feedbackDueCount}
    libraryItemCount={badges.libraryItemCount}
  >
    <!-- Page Header -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 mb-8">
      <h1 class="text-3xl font-heading font-bold text-clr-green mb-3">Preferences</h1>
      <p class="text-gray-600 text-lg">
        Manage your privacy settings and notification preferences.
      </p>
    </div>

    <!-- Preferences Form (no longer wrapping - sections are independent) -->
    <div class="space-y-8">

      <!-- Privacy Settings Section -->
      <form id="privacy-form" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <h2 class="text-2xl font-heading font-semibold text-clr-green mb-4">Privacy Settings</h2>

        <div class="space-y-4">
          <div>
            <label class="flex items-start gap-3 cursor-pointer">
              <input
                type="checkbox"
                id="share-contact-with-members"
                name="share_contact_with_members"
                class="mt-1 w-5 h-5 rounded border-gray-300 text-clr-green focus:ring-clr-green"
                checked={owner?.share_contact_with_members !== 0}
              />
              <div>
                <p class="text-base font-semibold text-gray-900">Share my contact info with members</p>
                <p class="text-sm text-gray-600 mt-1">Allow other HOA members to see your phone number and email in the member directory.</p>
              </div>
            </label>
          </div>

          <div class="text-base text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-4">
            <p class="font-semibold mb-1">Note about privacy:</p>
            <p>Even if you opt out, Board members, ARB members, and Admins can see your phone and email when needed to run the HOA. All such access is logged in the audit log for transparency.</p>
          </div>
        </div>

        <!-- Privacy Section Messages -->
        <div id="privacy-message" class="hidden mt-4 p-4 rounded-lg border" role="alert"></div>

        <!-- Privacy Save Button -->
        <div class="mt-6 pt-6 border-t border-gray-200">
          <button
            type="submit"
            id="privacy-save-btn"
            class="inline-flex items-center gap-2 bg-clr-green hover:brightness-110 text-white px-6 py-3 rounded-xl font-semibold text-base transition-all disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="privacy-btn-text">Save privacy settings</span>
            <svg id="privacy-spinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <svg id="privacy-checkmark" class="hidden h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </form>

      <!-- Notification Preferences Section -->
      <form id="notifications-form" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <h2 class="text-2xl font-heading font-semibold text-clr-green mb-4">Notification Preferences</h2>

        <!-- Email Notifications -->
        <div class="mb-6">
          <p class="text-base font-semibold text-gray-900 mb-3">Email notifications</p>
          <p class="text-sm text-gray-600 mb-4">Choose which types of updates you'd like to receive via email.</p>

          <ul class="space-y-3" aria-label="Notification type toggles">
            {NOTIFICATION_TYPES.map((t) => (
              <li>
                <label class="flex items-start gap-3 cursor-pointer">
                  <input
                    type="checkbox"
                    name="notification_type"
                    value={t.id}
                    data-notification-id={t.id}
                    class="mt-0.5 w-5 h-5 rounded border-gray-300 text-clr-green focus:ring-clr-green notification-type-cb"
                    checked={notification_preferences[t.id] !== false}
                  />
                  <div>
                    <p class="text-base font-medium text-gray-900">{t.label}</p>
                    <p class="text-sm text-gray-600">{t.description}</p>
                  </div>
                </label>
              </li>
            ))}
          </ul>
        </div>

        <!-- SMS Notifications -->
        <div class="mb-6 pb-6 border-b border-gray-200">
          <p class="text-base font-semibold text-gray-900 mb-3">SMS text alerts (optional)</p>
          <p class="text-sm text-gray-600 mb-4">Opt in to receive urgent notifications via text message. Standard messaging rates apply.</p>

          <label class="flex items-start gap-3 cursor-pointer mb-4">
            <input
              type="checkbox"
              id="sms_optin"
              name="sms_optin"
              class="mt-0.5 w-5 h-5 rounded border-gray-300 text-clr-green focus:ring-clr-green"
              checked={sms_optin}
            />
            <div>
              <p class="text-base font-medium text-gray-900">Enable SMS alerts</p>
              <p class="text-sm text-gray-600">You'll need to provide a phone number in your profile.</p>
            </div>
          </label>

          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-sm text-blue-900 font-semibold mb-2">SMS feature is in development</p>
            <p class="text-sm text-blue-800 mb-3">Help us prioritize SMS notifications by requesting this feature. We'll notify you when it's ready.</p>
            <button
              type="button"
              id="btn-request-sms"
              class="px-4 py-2 bg-clr-green text-white rounded-lg hover:brightness-110 font-medium text-sm transition-all disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Request SMS feature
            </button>
            <div id="sms-request-message" class="hidden mt-3 text-sm font-medium"></div>
          </div>
        </div>

        <!-- Browser Push Notifications -->
        <div class="mb-6">
          <p class="text-base font-semibold text-gray-900 mb-3">Browser push notifications</p>
          <p class="text-sm text-gray-600 mb-4">Get instant notifications in your browser even when the portal is closed.</p>

          <div class="flex gap-3">
            <button
              type="button"
              id="btn-enable-push"
              class="px-4 py-2 bg-clr-green text-white rounded-lg hover:brightness-110 font-medium text-sm transition-colors disabled:opacity-50"
              disabled={pushEnabled}
            >
              {pushEnabled ? 'Push notifications enabled' : 'Enable push notifications'}
            </button>
            {pushEnabled && (
              <button
                type="button"
                id="btn-disable-push"
                class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 font-medium text-sm transition-colors"
              >
                Disable push
              </button>
            )}
          </div>
        </div>

        <!-- Notifications Section Messages -->
        <div id="notifications-message" class="hidden mt-4 p-4 rounded-lg border" role="alert"></div>

        <!-- Save Button -->
        <div class="pt-6 mt-6 border-t border-gray-200">
          <button
            type="submit"
            id="notifications-save-btn"
            class="inline-flex items-center gap-2 bg-clr-green hover:brightness-110 text-white px-6 py-3 rounded-xl font-semibold text-base transition-all disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="notifications-btn-text">Save notification preferences</span>
            <svg id="notifications-spinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <svg id="notifications-checkmark" class="hidden h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </form>
    </div>

  </PortalPage>
</PortalLayout>

<script is:inline define:vars={{ csrfToken: session.csrfToken ?? '' }}>
  (function() {
  const privacyForm = document.getElementById('privacy-form');
  const notificationsForm = document.getElementById('notifications-form');

  /**
   * Show inline message with dismiss button
   */
  function showMessage(messageEl, text, isError) {
    if (!messageEl) return;

    messageEl.innerHTML = '';
    messageEl.classList.remove('hidden', 'bg-green-50', 'border-green-200', 'text-green-800', 'bg-red-50', 'border-red-200', 'text-red-800');

    if (isError) {
      messageEl.classList.add('bg-red-50', 'border-red-200', 'text-red-800');
    } else {
      messageEl.classList.add('bg-green-50', 'border-green-200', 'text-green-800');
    }

    // Create message content
    const content = document.createElement('div');
    content.className = 'flex items-start justify-between gap-3';

    const messageText = document.createElement('div');
    messageText.className = 'flex items-start gap-2 flex-1';

    // Icon
    const icon = document.createElement('svg');
    icon.className = 'w-5 h-5 mt-0.5 shrink-0';
    icon.setAttribute('fill', 'currentColor');
    icon.setAttribute('viewBox', '0 0 20 20');

    if (isError) {
      icon.innerHTML = '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />';
    } else {
      icon.innerHTML = '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />';
    }

    const textSpan = document.createElement('span');
    textSpan.className = 'text-base font-medium';
    textSpan.textContent = text;

    messageText.appendChild(icon);
    messageText.appendChild(textSpan);

    // Dismiss button
    const dismissBtn = document.createElement('button');
    dismissBtn.type = 'button';
    dismissBtn.className = 'shrink-0 hover:opacity-70 transition-opacity';
    dismissBtn.innerHTML = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>';
    dismissBtn.onclick = function() {
      messageEl.classList.add('hidden');
    };

    content.appendChild(messageText);
    content.appendChild(dismissBtn);
    messageEl.appendChild(content);

    // Auto-hide success messages after 8 seconds, errors stay until dismissed
    if (!isError) {
      setTimeout(() => messageEl.classList.add('hidden'), 8000);
    }
  }

  /**
   * Set button loading state
   */
  function setButtonLoading(btn, textEl, spinner, checkmark, isLoading) {
    if (!btn || !textEl || !spinner || !checkmark) return;

    btn.disabled = isLoading;
    if (isLoading) {
      spinner.classList.remove('hidden');
      checkmark.classList.add('hidden');
    } else {
      spinner.classList.add('hidden');
    }
  }

  /**
   * Show success checkmark briefly
   */
  function showSuccessCheckmark(checkmark) {
    if (!checkmark) return;
    checkmark.classList.remove('hidden');
    setTimeout(() => checkmark.classList.add('hidden'), 2000);
  }

  function getCurrentNotificationPrefs() {
    const prefs = {};
    document.querySelectorAll('.notification-type-cb').forEach(function (cb) {
      const checkbox = cb;
      prefs[checkbox.dataset.notificationId || checkbox.value] = checkbox.checked;
    });
    return prefs;
  }

  // Privacy Settings Form
  privacyForm?.addEventListener('submit', async function (e) {
    e.preventDefault();

    const messageEl = document.getElementById('privacy-message');
    const btn = document.getElementById('privacy-save-btn');
    const btnText = document.getElementById('privacy-btn-text');
    const spinner = document.getElementById('privacy-spinner');
    const checkmark = document.getElementById('privacy-checkmark');

    const shareContactEl = document.getElementById('share-contact-with-members');
    const share_contact_with_members = shareContactEl?.checked ?? true;

    setButtonLoading(btn, btnText, spinner, checkmark, true);

    try {
      const res = await fetch('/api/preferences', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          share_contact_with_members,
          csrf_token: csrfToken,
        }),
        credentials: 'same-origin',
      });

      const data = await res.json();
      setButtonLoading(btn, btnText, spinner, checkmark, false);

      if (data.success) {
        showSuccessCheckmark(checkmark);
        showMessage(messageEl, 'Privacy settings saved successfully!', false);
      } else {
        showMessage(messageEl, data.message || 'Failed to save privacy settings', true);
      }
    } catch (error) {
      setButtonLoading(btn, btnText, spinner, checkmark, false);
      showMessage(messageEl, 'An error occurred. Please try again.', true);
    }
  });

  // Notification Preferences Form
  notificationsForm?.addEventListener('submit', async function (e) {
    e.preventDefault();

    const messageEl = document.getElementById('notifications-message');
    const btn = document.getElementById('notifications-save-btn');
    const btnText = document.getElementById('notifications-btn-text');
    const spinner = document.getElementById('notifications-spinner');
    const checkmark = document.getElementById('notifications-checkmark');

    const smsEl = document.getElementById('sms_optin');
    const sms_optin = smsEl?.checked ?? false;
    const notification_preferences = getCurrentNotificationPrefs();

    setButtonLoading(btn, btnText, spinner, checkmark, true);

    try {
      const res = await fetch('/api/preferences', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sms_optin,
          notification_preferences,
          csrf_token: csrfToken,
        }),
        credentials: 'same-origin',
      });

      const data = await res.json();
      setButtonLoading(btn, btnText, spinner, checkmark, false);

      if (data.success) {
        showSuccessCheckmark(checkmark);
        showMessage(messageEl, 'Notification preferences saved successfully!', false);
      } else {
        showMessage(messageEl, data.message || 'Failed to save notification preferences', true);
      }
    } catch (error) {
      setButtonLoading(btn, btnText, spinner, checkmark, false);
      showMessage(messageEl, 'An error occurred. Please try again.', true);
    }
  });

  // Push notification handlers
  const enablePushBtn = document.getElementById('btn-enable-push');
  const disablePushBtn = document.getElementById('btn-disable-push');
  const notificationsMessageEl = document.getElementById('notifications-message');

  function updatePushUI(enabled) {
    if (enablePushBtn) {
      enablePushBtn.disabled = enabled;
      enablePushBtn.textContent = enabled ? 'Push notifications enabled' : 'Enable push notifications';
    }
    if (disablePushBtn) {
      disablePushBtn.style.display = enabled ? 'block' : 'none';
    }
  }

  async function savePushPreference(enabled) {
    const smsEl = document.getElementById('sms_optin');
    const sms_optin = smsEl?.checked ?? false;
    const notification_preferences = getCurrentNotificationPrefs();
    notification_preferences.push_enabled = enabled;

    try {
      const res = await fetch('/api/preferences', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sms_optin,
          notification_preferences,
          csrf_token: csrfToken,
        }),
      });
      return await res.json();
    } catch (error) {
      return { success: false };
    }
  }

  enablePushBtn?.addEventListener('click', async function () {
    if (!('Notification' in window)) {
      showMessage(notificationsMessageEl, 'Push notifications are not supported in this browser.', true);
      return;
    }

    try {
      const permission = await Notification.requestPermission();
      if (permission === 'granted') {
        const data = await savePushPreference(true);
        if (data.success) {
          updatePushUI(true);
          showMessage(notificationsMessageEl, 'Push notifications enabled!', false);
        } else {
          showMessage(notificationsMessageEl, 'Failed to enable push notifications', true);
        }
      }
    } catch (error) {
      showMessage(notificationsMessageEl, 'Failed to enable push notifications', true);
    }
  });

  disablePushBtn?.addEventListener('click', async function () {
    const data = await savePushPreference(false);
    if (data.success) {
      updatePushUI(false);
      showMessage(notificationsMessageEl, 'Push notifications disabled.', false);
    } else {
      showMessage(notificationsMessageEl, 'Failed to disable push notifications', true);
    }
  });

  // SMS Feature Request
  const smsRequestBtn = document.getElementById('btn-request-sms');
  const smsRequestMessage = document.getElementById('sms-request-message');

  smsRequestBtn?.addEventListener('click', async function () {
    smsRequestBtn.disabled = true;
    smsRequestBtn.textContent = 'Submitting...';

    try {
      const res = await fetch('/api/sms-feature-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });

      const data = await res.json();

      if (data.success) {
        smsRequestMessage.textContent = '✓ Request submitted! You\'ll be notified when SMS is available.';
        smsRequestMessage.className = 'mt-3 text-sm font-medium text-green-700';
        smsRequestMessage.classList.remove('hidden');
        smsRequestBtn.textContent = 'Request submitted';
      } else {
        smsRequestMessage.textContent = data.error || 'Failed to submit request.';
        smsRequestMessage.className = 'mt-3 text-sm font-medium text-red-700';
        smsRequestMessage.classList.remove('hidden');
        smsRequestBtn.disabled = false;
        smsRequestBtn.textContent = 'Request SMS feature';
      }
    } catch (error) {
      smsRequestMessage.textContent = 'Network error. Please try again.';
      smsRequestMessage.className = 'mt-3 text-sm font-medium text-red-700';
      smsRequestMessage.classList.remove('hidden');
      smsRequestBtn.disabled = false;
      smsRequestBtn.textContent = 'Request SMS feature';
    }
  });
  })();
</script>
