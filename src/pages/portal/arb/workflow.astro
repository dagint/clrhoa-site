---
/**
 * ARB Workflow Reference: /portal/arb/workflow
 *
 * Documents the full V2 ARB multi-stage voting workflow with:
 * - Visual flowchart of all stages and transitions
 * - Dynamic approval thresholds based on current active members
 * - Current ARC Committee and Board member roster
 * - Email notification matrix with actual recipient addresses
 * - Voting rules and auto-approval deadline rules
 *
 * Access: elevated users only (arb, board, arb_board, admin)
 */
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import PortalPage from '../../../components/PortalPage.astro';
import ElevatedNav from '../../../components/ElevatedNav.astro';
import { getPortalContext } from '../../../lib/portal-context';
import { getPortalBadgeCounts } from '../../../lib/portal-badge-counts';
import { getCurrentPositions } from '../../../lib/board-positions-db';

const { env, session, effectiveRole } = await getPortalContext(Astro);
if (!session) return Astro.redirect('/auth/login');

const allowedRoles = ['arb', 'board', 'admin', 'arb_board'];
if (!allowedRoles.includes(effectiveRole)) {
  return Astro.redirect(
    '/portal/request-elevated-access?return=' + encodeURIComponent('/portal/arb/workflow')
  );
}

const { email, role, name } = session;
const db = env?.DB;

// Fetch ARC members (role = 'arb' or 'arb_board') — same query used by notification triggers
const arcResult = db
  ? await db
      .prepare(
        `SELECT email, name, role FROM users
         WHERE (role = 'arb' OR role = 'arb_board') AND status = 'active'
         ORDER BY name`
      )
      .all<{ email: string; name: string | null; role: string }>()
  : { results: [] };
const arcMembers = arcResult.results ?? [];

// Fetch Board members (role = 'board' or 'arb_board')
const boardResult = db
  ? await db
      .prepare(
        `SELECT email, name, role FROM users
         WHERE (role = 'board' OR role = 'arb_board') AND status = 'active'
         ORDER BY name`
      )
      .all<{ email: string; name: string | null; role: string }>()
  : { results: [] };
const boardMembers = boardResult.results ?? [];

// Board position titles keyed by email
const positions = db ? await getCurrentPositions(db) : [];
const positionByEmail = new Map(positions.map(p => [p.email.toLowerCase(), p.title]));

// Notification group email addresses
const notifyArbEmail = (env as any)?.NOTIFY_ARB_EMAIL ?? '(not configured)';
const notifyBoardEmail = (env as any)?.NOTIFY_BOARD_EMAIL ?? '(not configured)';

// Dynamic approval thresholds: majority = floor(count / 2) + 1
const arcCount = arcMembers.length;
const boardCount = boardMembers.length;
const arcMajority = arcCount > 0 ? Math.floor(arcCount / 2) + 1 : 0;
const boardMajority = boardCount > 0 ? Math.floor(boardCount / 2) + 1 : 0;

// Nav badge counts
const badges = await getPortalBadgeCounts(db, email, role, name);

// Pick ElevatedNav persona based on effective role
const navPersona: 'admin' | 'board' | 'arb' =
  effectiveRole === 'admin' ? 'admin'
  : effectiveRole === 'board' ? 'board'
  : 'arb';
---

<PortalLayout title="ARB Workflow Reference | Member Portal | Crooked Lake Reserve HOA">
  <PortalPage
    currentPath="/portal/arb/workflow"
    pageTitle="ARB Workflow Reference"
    userName={badges.displayName ?? undefined}
    userEmail={email}
    effectiveRole={effectiveRole}
    draftCount={badges.draftCount}
    role={effectiveRole}
    staffRole={role ?? ''}
    arbInReviewCount={badges.arbInReviewCount}
    vendorPendingCount={badges.vendorPendingCount}
    maintenanceOpenCount={badges.maintenanceOpenCount}
    meetingsRsvpCount={badges.meetingsRsvpCount}
    feedbackDueCount={badges.feedbackDueCount}
    libraryItemCount={badges.libraryItemCount}
  >
    <ElevatedNav
      persona={navPersona}
      currentPath="/portal/arb/workflow"
      effectiveRole={effectiveRole}
      user={{ email, role: role ?? '' }}
      session={session}
    />

    <div class="mb-8">
      <h1 class="text-3xl font-heading font-bold text-clr-green mb-2">ARB Workflow Reference</h1>
      <p class="text-gray-600 text-lg">
        Multi-stage voting process, current approval thresholds, member roster, and email notifications
      </p>
    </div>

    <!-- ── Approval Thresholds ─────────────────────────────────────────── -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
      <h2 class="text-base font-semibold text-gray-500 uppercase tracking-wide mb-4">
        Current Approval Thresholds
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div class="p-4 rounded-xl bg-blue-50 border border-blue-200">
          <div class="text-sm font-medium text-blue-700 mb-1">ARC Committee</div>
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-bold text-blue-800">{arcMajority}</span>
            <span class="text-lg text-blue-600">of {arcCount} vote{arcCount !== 1 ? 's' : ''}</span>
          </div>
          <div class="text-sm text-blue-600 mt-1">needed to approve, deny, or return</div>
          <div class="text-xs text-blue-400 mt-2 font-mono">floor({arcCount} ÷ 2) + 1 = {arcMajority}</div>
        </div>
        <div class="p-4 rounded-xl bg-purple-50 border border-purple-200">
          <div class="text-sm font-medium text-purple-700 mb-1">Board of Directors</div>
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-bold text-purple-800">{boardMajority}</span>
            <span class="text-lg text-purple-600">of {boardCount} vote{boardCount !== 1 ? 's' : ''}</span>
          </div>
          <div class="text-sm text-purple-600 mt-1">needed to approve, deny, or return</div>
          <div class="text-xs text-purple-400 mt-2 font-mono">floor({boardCount} ÷ 2) + 1 = {boardMajority}</div>
        </div>
      </div>
      <p class="text-xs text-gray-500">
        Abstentions reduce the eligible voter pool before the majority is calculated.
        Thresholds update automatically as members are added or removed from the system.
      </p>
    </section>

    <!-- ── Workflow Flowchart ──────────────────────────────────────────── -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
      <h2 class="text-base font-semibold text-gray-500 uppercase tracking-wide mb-6">
        Workflow Stages (V2 Multi-Stage Voting)
      </h2>

      <!-- SVG Flowchart -->
      <div class="overflow-x-auto pb-2">
        <svg
          viewBox="0 0 820 260"
          width="820"
          height="260"
          class="min-w-[820px]"
          aria-label="ARB workflow flowchart"
          role="img"
        >
          <!-- ── STYLES ── -->
          <defs>
            <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
              <path d="M0,0 L0,6 L8,3 z" fill="#9ca3af" />
            </marker>
            <marker id="arrow-ret" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
              <path d="M0,0 L0,6 L8,3 z" fill="#ca8a04" />
            </marker>
          </defs>

          <!-- ── MAIN PATH ARROWS (y=45, midpoint of main boxes at y=26 h=38) ── -->
          <!-- DRAFT → SUBMITTED -->
          <line x1="108" y1="45" x2="122" y2="45" stroke="#9ca3af" stroke-width="1.5" marker-end="url(#arrow)" />
          <!-- SUBMITTED → ARC REVIEW -->
          <line x1="230" y1="45" x2="244" y2="45" stroke="#9ca3af" stroke-width="1.5" marker-end="url(#arrow)" />
          <!-- ARC REVIEW → ARC APPROVED -->
          <line x1="352" y1="45" x2="366" y2="45" stroke="#9ca3af" stroke-width="1.5" marker-end="url(#arrow)" />
          <!-- ARC APPROVED → BOARD REVIEW -->
          <line x1="474" y1="45" x2="488" y2="45" stroke="#9ca3af" stroke-width="1.5" marker-end="url(#arrow)" />
          <!-- BOARD REVIEW → BOARD APPROVED -->
          <line x1="596" y1="45" x2="610" y2="45" stroke="#9ca3af" stroke-width="1.5" marker-end="url(#arrow)" />

          <!-- ── DOWN ARROWS from ARC REVIEW → ARC_DENIED / ARC_RETURNED ── -->
          <line x1="298" y1="64" x2="298" y2="126" stroke="#9ca3af" stroke-width="1.5" marker-end="url(#arrow)" />
          <line x1="298" y1="162" x2="298" y2="196" stroke="#9ca3af" stroke-width="1.5" marker-end="url(#arrow)" />

          <!-- ── DOWN ARROWS from BOARD REVIEW → BOARD_DENIED / BOARD_RETURNED ── -->
          <line x1="542" y1="64" x2="542" y2="126" stroke="#9ca3af" stroke-width="1.5" marker-end="url(#arrow)" />
          <line x1="542" y1="162" x2="542" y2="196" stroke="#9ca3af" stroke-width="1.5" marker-end="url(#arrow)" />

          <!-- ── RETURN ARROWS (ARC_RETURNED → SUBMITTED, BOARD_RETURNED → SUBMITTED) ── -->
          <!-- ARC_RETURNED: from right side (x=366, y=215) path up & left to SUBMITTED (x=176, y=26) -->
          <path
            d="M 366,215 Q 420,215 420,255 Q 420,258 176,258 Q 110,258 110,64 Q 110,45 176,45"
            fill="none" stroke="#ca8a04" stroke-width="1.5" stroke-dasharray="5,3"
            marker-end="url(#arrow-ret)"
          />

          <!-- BOARD_RETURNED: from right side (x=610, y=215) path further right then up and way left to SUBMITTED -->
          <path
            d="M 610,215 Q 700,215 700,258 Q 700,260 176,260 Q 110,260 110,64 Q 110,45 176,45"
            fill="none" stroke="#ca8a04" stroke-width="1.5" stroke-dasharray="5,3"
            marker-end="url(#arrow-ret)"
          />

          <!-- ── MAIN PATH BOXES (y=26, h=38, rx=6) ── -->

          <!-- DRAFT: gray -->
          <rect x="8" y="26" width="100" height="38" rx="6" fill="#f3f4f6" stroke="#9ca3af" stroke-width="1.5" />
          <text x="58" y="45" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="600" fill="#374151">DRAFT</text>
          <text x="58" y="58" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#6b7280">Owner editing</text>

          <!-- SUBMITTED: sky -->
          <rect x="122" y="26" width="108" height="38" rx="6" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5" />
          <text x="176" y="45" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="600" fill="#0c4a6e">SUBMITTED</text>
          <text x="176" y="58" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#0369a1">Queued for ARC</text>

          <!-- ARC REVIEW: blue -->
          <rect x="244" y="26" width="108" height="38" rx="6" fill="#dbeafe" stroke="#2563eb" stroke-width="2" />
          <text x="298" y="45" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="600" fill="#1e3a8a">ARC REVIEW</text>
          <text x="298" y="58" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#1d4ed8">ARC votes</text>

          <!-- ARC APPROVED: teal -->
          <rect x="366" y="26" width="108" height="38" rx="6" fill="#ccfbf1" stroke="#0f766e" stroke-width="1.5" />
          <text x="420" y="45" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="600" fill="#134e4a">ARC APPROVED</text>
          <text x="420" y="58" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#0f766e">Auto-advances</text>

          <!-- BOARD REVIEW: purple -->
          <rect x="488" y="26" width="108" height="38" rx="6" fill="#f3e8ff" stroke="#7c3aed" stroke-width="2" />
          <text x="542" y="45" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="600" fill="#3b0764">BOARD REVIEW</text>
          <text x="542" y="58" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#6d28d9">Board votes</text>

          <!-- BOARD APPROVED: green -->
          <rect x="610" y="26" width="112" height="38" rx="6" fill="#dcfce7" stroke="#16a34a" stroke-width="2" />
          <text x="666" y="45" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="700" fill="#14532d">BOARD APPROVED</text>
          <text x="666" y="58" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#15803d">Final approval ✓</text>

          <!-- ── BRANCH BOXES ── -->

          <!-- ARC DENIED: red (under ARC REVIEW) -->
          <rect x="244" y="128" width="108" height="36" rx="6" fill="#fee2e2" stroke="#dc2626" stroke-width="1.5" />
          <text x="298" y="146" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="600" fill="#991b1b">ARC DENIED</text>
          <text x="298" y="158" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#b91c1c">Terminal</text>

          <!-- ARC RETURNED: yellow (under ARC DENIED) -->
          <rect x="244" y="196" width="108" height="36" rx="6" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5" />
          <text x="298" y="214" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="600" fill="#713f12">ARC RETURNED</text>
          <text x="298" y="226" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#92400e">Owner revises</text>

          <!-- BOARD DENIED: red (under BOARD REVIEW) -->
          <rect x="488" y="128" width="108" height="36" rx="6" fill="#fee2e2" stroke="#dc2626" stroke-width="1.5" />
          <text x="542" y="146" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="600" fill="#991b1b">BOARD DENIED</text>
          <text x="542" y="158" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#b91c1c">Terminal</text>

          <!-- BOARD RETURNED: yellow (under BOARD DENIED) -->
          <rect x="488" y="196" width="122" height="36" rx="6" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5" />
          <text x="549" y="214" text-anchor="middle" dominant-baseline="middle" font-size="11" font-weight="600" fill="#713f12">BOARD RETURNED</text>
          <text x="549" y="226" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#92400e">Owner revises (→ ARC again)</text>

          <!-- ── RETURN ARROW LABELS ── -->
          <text x="430" y="252" text-anchor="middle" font-size="9" fill="#ca8a04">resubmit → back to SUBMITTED</text>
        </svg>
      </div>

      <!-- Legend -->
      <div class="flex flex-wrap gap-4 mt-4 pt-4 border-t border-gray-100 text-xs text-gray-600">
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-3 h-3 rounded border border-gray-400 bg-gray-100"></span>Draft / editing
        </span>
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-3 h-3 rounded border border-blue-500 bg-blue-100"></span>Under review
        </span>
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-3 h-3 rounded border border-green-500 bg-green-100"></span>Approved (terminal)
        </span>
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-3 h-3 rounded border border-red-500 bg-red-100"></span>Denied (terminal)
        </span>
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-3 h-3 rounded border border-yellow-500 bg-yellow-100"></span>Returned for revision
        </span>
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-8 border-t border-dashed border-yellow-600"></span>Resubmit loop
        </span>
      </div>

      <!-- Key workflow rules -->
      <div class="mt-4 p-4 bg-amber-50 border border-amber-200 rounded-xl text-sm">
        <p class="font-semibold text-amber-900 mb-2">Key Rules</p>
        <ul class="list-disc list-inside space-y-1 text-amber-800">
          <li>Owner can only edit the request in <strong>DRAFT</strong>, <strong>ARC_RETURNED</strong>, or <strong>BOARD_RETURNED</strong></li>
          <li><strong>ARC_APPROVED</strong> auto-advances to <strong>BOARD_REVIEW</strong> immediately (no manual step)</li>
          <li><strong>BOARD_RETURNED</strong> sends the request back to <strong>SUBMITTED</strong> — it goes through ARC review again in a new cycle</li>
          <li>Requests <strong>auto-approve after 30 days</strong> of inactivity in any review stage (statute compliance)</li>
          <li>Owner can cancel from <strong>DRAFT</strong> or <strong>SUBMITTED</strong> only</li>
        </ul>
      </div>
    </section>

    <!-- ── Stage-by-Stage Detail ───────────────────────────────────────── -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
      <h2 class="text-base font-semibold text-gray-500 uppercase tracking-wide mb-4">Stage Detail</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[600px]">
          <thead>
            <tr class="text-left border-b border-gray-200">
              <th class="pb-2 pr-4 text-gray-500 font-medium">Stage</th>
              <th class="pb-2 pr-4 text-gray-500 font-medium">Who acts</th>
              <th class="pb-2 pr-4 text-gray-500 font-medium">Possible outcomes</th>
              <th class="pb-2 text-gray-500 font-medium">Owner can edit?</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 text-gray-700">
            <tr>
              <td class="py-3 pr-4 font-semibold">DRAFT</td>
              <td class="py-3 pr-4">Owner</td>
              <td class="py-3 pr-4">Submit for ARC review, or cancel</td>
              <td class="py-3"><span class="text-green-600 font-medium">Yes</span></td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-semibold">SUBMITTED</td>
              <td class="py-3 pr-4">ARC member (opens review)</td>
              <td class="py-3 pr-4">Begin ARC_REVIEW, or owner cancels</td>
              <td class="py-3"><span class="text-red-500">No</span></td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-semibold">ARC_REVIEW</td>
              <td class="py-3 pr-4">All ARC members vote</td>
              <td class="py-3 pr-4">
                <span class="inline-block mr-1 px-1.5 py-0.5 rounded text-xs bg-teal-100 text-teal-700 font-medium">ARC_APPROVED</span>
                <span class="inline-block mr-1 px-1.5 py-0.5 rounded text-xs bg-red-100 text-red-700 font-medium">ARC_DENIED</span>
                <span class="inline-block px-1.5 py-0.5 rounded text-xs bg-yellow-100 text-yellow-700 font-medium">ARC_RETURNED</span>
              </td>
              <td class="py-3"><span class="text-red-500">No</span></td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-semibold">ARC_APPROVED</td>
              <td class="py-3 pr-4">System (auto)</td>
              <td class="py-3 pr-4">Advances to BOARD_REVIEW automatically</td>
              <td class="py-3"><span class="text-red-500">No</span></td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-semibold">ARC_DENIED</td>
              <td class="py-3 pr-4">—</td>
              <td class="py-3 pr-4 text-red-600">Terminal — request closed</td>
              <td class="py-3"><span class="text-red-500">No</span></td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-semibold">ARC_RETURNED</td>
              <td class="py-3 pr-4">Owner</td>
              <td class="py-3 pr-4">Revise and resubmit (→ SUBMITTED, new cycle)</td>
              <td class="py-3"><span class="text-green-600 font-medium">Yes</span></td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-semibold">BOARD_REVIEW</td>
              <td class="py-3 pr-4">All Board members vote</td>
              <td class="py-3 pr-4">
                <span class="inline-block mr-1 px-1.5 py-0.5 rounded text-xs bg-green-100 text-green-700 font-medium">BOARD_APPROVED</span>
                <span class="inline-block mr-1 px-1.5 py-0.5 rounded text-xs bg-red-100 text-red-700 font-medium">BOARD_DENIED</span>
                <span class="inline-block px-1.5 py-0.5 rounded text-xs bg-yellow-100 text-yellow-700 font-medium">BOARD_RETURNED</span>
              </td>
              <td class="py-3"><span class="text-red-500">No</span></td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-semibold">BOARD_APPROVED</td>
              <td class="py-3 pr-4">—</td>
              <td class="py-3 pr-4 text-green-600">Terminal — request approved</td>
              <td class="py-3"><span class="text-red-500">No</span></td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-semibold">BOARD_DENIED</td>
              <td class="py-3 pr-4">—</td>
              <td class="py-3 pr-4 text-red-600">Terminal — request denied</td>
              <td class="py-3"><span class="text-red-500">No</span></td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-semibold">BOARD_RETURNED</td>
              <td class="py-3 pr-4">Owner</td>
              <td class="py-3 pr-4">Revise and resubmit (→ SUBMITTED, through ARC again)</td>
              <td class="py-3"><span class="text-green-600 font-medium">Yes</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── ARC Committee Members ───────────────────────────────────────── -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
      <h2 class="text-base font-semibold text-gray-500 uppercase tracking-wide mb-1">
        ARC Committee
      </h2>
      <p class="text-sm text-gray-500 mb-4">
        {arcCount} active member{arcCount !== 1 ? 's' : ''} &mdash;
        majority required: <strong>{arcMajority} vote{arcMajority !== 1 ? 's' : ''}</strong>
      </p>

      {arcMembers.length === 0 ? (
        <p class="text-gray-500 text-sm italic">No active ARC members configured.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left border-b border-gray-100">
                <th class="pb-2 pr-6 text-gray-500 font-medium">Name</th>
                <th class="pb-2 pr-6 text-gray-500 font-medium">Email</th>
                <th class="pb-2 pr-6 text-gray-500 font-medium">Board Title</th>
                <th class="pb-2 text-gray-500 font-medium">System Role</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              {arcMembers.map(m => (
                <tr>
                  <td class="py-2.5 pr-6 font-medium text-gray-800">{m.name ?? '—'}</td>
                  <td class="py-2.5 pr-6 text-gray-600">{m.email}</td>
                  <td class="py-2.5 pr-6 text-gray-600">{positionByEmail.get(m.email.toLowerCase()) ?? '—'}</td>
                  <td class="py-2.5">
                    {m.role === 'arb_board' ? (
                      <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700">ARB + Board</span>
                    ) : (
                      <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">ARC Member</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <p class="text-xs text-gray-400 mt-3">Group email: {notifyArbEmail}</p>
    </section>

    <!-- ── Board of Directors ─────────────────────────────────────────── -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
      <h2 class="text-base font-semibold text-gray-500 uppercase tracking-wide mb-1">
        Board of Directors
      </h2>
      <p class="text-sm text-gray-500 mb-4">
        {boardCount} active member{boardCount !== 1 ? 's' : ''} &mdash;
        majority required: <strong>{boardMajority} vote{boardMajority !== 1 ? 's' : ''}</strong>
      </p>

      {boardMembers.length === 0 ? (
        <p class="text-gray-500 text-sm italic">No active Board members configured.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left border-b border-gray-100">
                <th class="pb-2 pr-6 text-gray-500 font-medium">Name</th>
                <th class="pb-2 pr-6 text-gray-500 font-medium">Email</th>
                <th class="pb-2 pr-6 text-gray-500 font-medium">Board Title</th>
                <th class="pb-2 text-gray-500 font-medium">System Role</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              {boardMembers.map(m => (
                <tr>
                  <td class="py-2.5 pr-6 font-medium text-gray-800">{m.name ?? '—'}</td>
                  <td class="py-2.5 pr-6 text-gray-600">{m.email}</td>
                  <td class="py-2.5 pr-6 text-gray-600">{positionByEmail.get(m.email.toLowerCase()) ?? '—'}</td>
                  <td class="py-2.5">
                    {m.role === 'arb_board' ? (
                      <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700">ARB + Board</span>
                    ) : (
                      <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700">Board</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <p class="text-xs text-gray-400 mt-3">Group email: {notifyBoardEmail}</p>
    </section>

    <!-- ── Email Notification Matrix ──────────────────────────────────── -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
      <h2 class="text-base font-semibold text-gray-500 uppercase tracking-wide mb-2">
        Email Notification Matrix
      </h2>
      <p class="text-sm text-gray-500 mb-5">
        Emails are sent to individual portal accounts. Members with role <em>arb_board</em> receive both ARC and Board notifications.
        Owner notification delivery respects each owner's <em>arb_updates</em> preference setting.
      </p>

      <div class="space-y-4">

        <!-- Notification 1 -->
        <div class="border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-4 py-3 bg-sky-50 border-b border-gray-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-sky-200 text-sky-800 text-xs font-bold flex items-center justify-center">1</span>
            <span class="font-semibold text-gray-800">Request Submitted</span>
            <span class="text-xs text-gray-500">DRAFT → SUBMITTED (owner submits or resubmits)</span>
          </div>
          <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Recipients</div>
              <div class="font-medium text-blue-700">All ARC members</div>
              {arcMembers.map(m => (
                <div class="text-xs text-gray-500 ml-2">• {m.name ?? m.email} &lt;{m.email}&gt;</div>
              ))}
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</div>
              <div class="text-gray-600 text-xs">Always sent. No debounce. Triggered on both initial submit and resubmit after return.</div>
            </div>
          </div>
        </div>

        <!-- Notification 2 -->
        <div class="border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-4 py-3 bg-blue-50 border-b border-gray-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-200 text-blue-800 text-xs font-bold flex items-center justify-center">2</span>
            <span class="font-semibold text-gray-800">ARC Review Started</span>
            <span class="text-xs text-gray-500">SUBMITTED → ARC_REVIEW (ARC member opens for review)</span>
          </div>
          <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Recipients</div>
              <div class="font-medium text-gray-700">Request owner</div>
              <div class="text-xs text-gray-500 ml-2">• Owner's portal email</div>
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</div>
              <div class="text-gray-600 text-xs">Only sent if owner has <code class="bg-gray-100 px-1 rounded">arb_updates</code> notifications enabled.</div>
            </div>
          </div>
        </div>

        <!-- Notification 3 -->
        <div class="border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-4 py-3 bg-blue-50 border-b border-gray-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-200 text-blue-800 text-xs font-bold flex items-center justify-center">3</span>
            <span class="font-semibold text-gray-800">ARC Vote Cast</span>
            <span class="text-xs text-gray-500">Any ARC member casts a vote during ARC_REVIEW</span>
          </div>
          <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Recipients</div>
              <div class="font-medium text-blue-700">All ARC members</div>
              {arcMembers.map(m => (
                <div class="text-xs text-gray-500 ml-2">• {m.name ?? m.email} &lt;{m.email}&gt;</div>
              ))}
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</div>
              <div class="text-gray-600 text-xs">
                <strong>Debounced:</strong> at most 1 email per 30 minutes per request. Rapid voting produces only one batch notification.
              </div>
            </div>
          </div>
        </div>

        <!-- Notification 4 -->
        <div class="border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-4 py-3 bg-teal-50 border-b border-gray-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-teal-200 text-teal-800 text-xs font-bold flex items-center justify-center">4</span>
            <span class="font-semibold text-gray-800">ARC Decision</span>
            <span class="text-xs text-gray-500">ARC_REVIEW → ARC_APPROVED / ARC_DENIED / ARC_RETURNED</span>
          </div>
          <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Recipients</div>
              <div class="font-medium text-gray-700">Request owner</div>
              <div class="text-xs text-gray-500 ml-2 mb-2">• If arb_updates enabled</div>
              <div class="font-medium text-purple-700">+ All Board members <em>(on ARC_APPROVED only)</em></div>
              {boardMembers.map(m => (
                <div class="text-xs text-gray-500 ml-2">• {m.name ?? m.email} &lt;{m.email}&gt;</div>
              ))}
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</div>
              <div class="text-gray-600 text-xs">
                Board is notified only when ARC approves (advancing to BOARD_REVIEW).
                Denied or returned outcomes notify owner only.
              </div>
            </div>
          </div>
        </div>

        <!-- Notification 5 -->
        <div class="border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-4 py-3 bg-purple-50 border-b border-gray-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-purple-200 text-purple-800 text-xs font-bold flex items-center justify-center">5</span>
            <span class="font-semibold text-gray-800">Board Review Started</span>
            <span class="text-xs text-gray-500">ARC_APPROVED → BOARD_REVIEW (automatic advancement)</span>
          </div>
          <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Recipients</div>
              <div class="font-medium text-gray-700">Request owner</div>
              <div class="text-xs text-gray-500 ml-2 mb-2">• If arb_updates enabled</div>
              <div class="font-medium text-purple-700">All Board members</div>
              {boardMembers.map(m => (
                <div class="text-xs text-gray-500 ml-2">• {m.name ?? m.email} &lt;{m.email}&gt;</div>
              ))}
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</div>
              <div class="text-gray-600 text-xs">Always sent to all Board members regardless of preferences.</div>
            </div>
          </div>
        </div>

        <!-- Notification 6 -->
        <div class="border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-4 py-3 bg-purple-50 border-b border-gray-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-purple-200 text-purple-800 text-xs font-bold flex items-center justify-center">6</span>
            <span class="font-semibold text-gray-800">Board Vote Cast</span>
            <span class="text-xs text-gray-500">Any Board member casts a vote during BOARD_REVIEW</span>
          </div>
          <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Recipients</div>
              <div class="font-medium text-purple-700">All Board members</div>
              {boardMembers.map(m => (
                <div class="text-xs text-gray-500 ml-2">• {m.name ?? m.email} &lt;{m.email}&gt;</div>
              ))}
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</div>
              <div class="text-gray-600 text-xs">
                <strong>Debounced:</strong> at most 1 email per 30 minutes per request.
              </div>
            </div>
          </div>
        </div>

        <!-- Notification 7 -->
        <div class="border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-4 py-3 bg-green-50 border-b border-gray-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-green-200 text-green-800 text-xs font-bold flex items-center justify-center">7</span>
            <span class="font-semibold text-gray-800">Board Decision</span>
            <span class="text-xs text-gray-500">BOARD_REVIEW → BOARD_APPROVED / BOARD_DENIED / BOARD_RETURNED</span>
          </div>
          <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Recipients</div>
              <div class="font-medium text-gray-700">Request owner</div>
              <div class="text-xs text-gray-500 ml-2">• If arb_updates enabled</div>
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</div>
              <div class="text-gray-600 text-xs">
                Final outcome notification sent to owner with vote counts and any board comment.
              </div>
            </div>
          </div>
        </div>

        <!-- Notification 8 & 9: Deadline warnings -->
        <div class="border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-4 py-3 bg-amber-50 border-b border-gray-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-amber-200 text-amber-800 text-xs font-bold flex items-center justify-center">8</span>
            <span class="font-semibold text-gray-800">Deadline Warnings — 7 days &amp; 3 days</span>
            <span class="text-xs text-gray-500">Sent by scheduled job when deadline approaches</span>
          </div>
          <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Recipients</div>
              <div class="font-medium text-blue-700">ARC members <em>(if in ARC_REVIEW)</em></div>
              {arcMembers.map(m => (
                <div class="text-xs text-gray-500 ml-2">• {m.name ?? m.email} &lt;{m.email}&gt;</div>
              ))}
              <div class="font-medium text-purple-700 mt-2">Board members <em>(if in BOARD_REVIEW)</em></div>
              {boardMembers.map(m => (
                <div class="text-xs text-gray-500 ml-2">• {m.name ?? m.email} &lt;{m.email}&gt;</div>
              ))}
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</div>
              <div class="text-gray-600 text-xs">
                Sent at 7 days and again at 3 days before the 30-day auto-approval deadline.
                <strong>Debounced:</strong> once per 24 hours per request (avoids repeat emails from repeated job runs).
              </div>
            </div>
          </div>
        </div>

        <!-- Notification 10 -->
        <div class="border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-4 py-3 bg-gray-50 border-b border-gray-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-300 text-gray-700 text-xs font-bold flex items-center justify-center">9</span>
            <span class="font-semibold text-gray-800">Auto-Approved</span>
            <span class="text-xs text-gray-500">30-day deadline expires without a decision</span>
          </div>
          <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Recipients</div>
              <div class="font-medium text-gray-700">Request owner</div>
              <div class="text-xs text-gray-500 ml-2 mb-2">• If arb_updates enabled</div>
              <div class="font-medium text-purple-700">+ All Board members <em>(if ARC stage auto-approved)</em></div>
              {boardMembers.map(m => (
                <div class="text-xs text-gray-500 ml-2">• {m.name ?? m.email} &lt;{m.email}&gt;</div>
              ))}
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</div>
              <div class="text-gray-600 text-xs">
                If ARC stage auto-approves, Board is notified that it advances to BOARD_REVIEW.
                If BOARD stage auto-approves, only the owner is notified (final approval).
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ── Voting Rules ────────────────────────────────────────────────── -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
      <h2 class="text-base font-semibold text-gray-500 uppercase tracking-wide mb-4">Voting Rules</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">
        <div>
          <h3 class="font-semibold text-gray-800 mb-3">Vote Options</h3>
          <ul class="space-y-2.5">
            <li class="flex items-start gap-2.5">
              <span class="mt-1 flex-shrink-0 w-2.5 h-2.5 rounded-full bg-green-500"></span>
              <span><strong>Approve</strong> — Recommend approval of the request</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-1 flex-shrink-0 w-2.5 h-2.5 rounded-full bg-red-500"></span>
              <span><strong>Deny</strong> — Reject the request outright</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-1 flex-shrink-0 w-2.5 h-2.5 rounded-full bg-yellow-500"></span>
              <span><strong>Return</strong> — Send back to owner with comments for revision</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-1 flex-shrink-0 w-2.5 h-2.5 rounded-full bg-gray-400"></span>
              <span><strong>Abstain</strong> — Opt out; removes voter from the eligible pool, reducing the denominator</span>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-gray-800 mb-3">Outcome Calculation</h3>
          <ul class="space-y-1.5 text-gray-700">
            <li><strong>Active voters</strong> = total eligible &minus; abstentions</li>
            <li><strong>Majority needed</strong> = floor(active voters &divide; 2) + 1</li>
            <li><strong>Outcome</strong>: whichever option (approve / deny / return) first reaches majority wins</li>
            <li><strong>Deadlock</strong>: no option reaches majority by the 30-day deadline &rarr; auto-approve</li>
          </ul>
          <div class="mt-4 p-3 bg-gray-50 rounded-xl text-xs text-gray-600 font-mono">
            Example: 5 ARC members, 1 abstains<br/>
            Active = 4 &nbsp;|&nbsp; Majority = floor(4/2)+1 = 3<br/>
            Need 3 votes on the same outcome to decide
          </div>
        </div>
      </div>
    </section>

    <p class="mt-2 text-sm text-gray-500">
      <a href="/portal/arb/dashboard" class="text-clr-green hover:underline">&larr; Back to ARB Dashboard</a>
    </p>
  </PortalPage>
</PortalLayout>
