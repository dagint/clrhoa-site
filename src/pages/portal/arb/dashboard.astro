---
/**
 * ARB Dashboard: /portal/arb/dashboard
 *
 * Landing zone for ARB elevation.
 * Shows quick stats and provides access to ARB workflow.
 */
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import PortalPage from '../../../components/PortalPage.astro';
import ElevatedNav from '../../../components/ElevatedNav.astro';
import { getPortalContext } from '../../../lib/portal-context';
import { getPortalBadgeCounts } from '../../../lib/portal-badge-counts';

const { env, session, effectiveRole } = await getPortalContext(Astro);
if (!session) return Astro.redirect('/auth/login');

const allowedRoles = ['arb', 'board', 'admin', 'arb_board'];
if (!allowedRoles.includes(effectiveRole)) {
  return Astro.redirect('/portal/request-elevated-access?return=' + encodeURIComponent('/portal/arb/dashboard'));
}

const { email, role, name } = session;
const db = env?.DB;
const badges = await getPortalBadgeCounts(db, email, role, name);

// Redirect to full ARB workflow dashboard
// This is a landing/overview page, the full dashboard is at /portal/arb-dashboard
// We'll consolidate these later, but for now this serves as the entry point
return Astro.redirect('/portal/arb-dashboard');
---
