---
/**
 * Members-only compliance page - View all compliance requirements and their status
 * Shows Florida Statute 720.303(4) compliance with clear indicators of what's met and missing
 */
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import PortalPage from '../../components/PortalPage.astro';
import { getPortalContext } from '../../lib/portal-context';
import { getPortalBadgeCounts } from '../../lib/portal-badge-counts';
import { getComplianceStatus } from '../../lib/compliance-db';
import { listPublicDocuments } from '../../lib/public-documents-db';

const { env, session, effectiveRole } = await getPortalContext(Astro);
if (!session) return Astro.redirect('/auth/login');

const { email, role, name } = session;
const db = env?.DB;
if (!db) {
  return new Response('Service unavailable', { status: 503 });
}

const badges = await getPortalBadgeCounts(db, email, role, name);

// Get full compliance status
const complianceData = await getComplianceStatus(db);

// Fetch public documents to check if they satisfy any requirements
const publicDocs = await listPublicDocuments(db);
const publicDocsBySlug = Object.fromEntries(publicDocs.map(d => [d.slug, d]));

// Map public doc slugs to compliance requirement IDs
const publicDocToRequirement: Record<string, string> = {
  'bylaws': 'HOA-02',
  'covenants': 'HOA-03',
};

// Enhance compliance statuses with public doc references and recalculate status
const enhancedStatuses = complianceData.statuses.map((status) => {
  if (!status.document) {
    // Check if there's a public doc that satisfies this requirement
    const publicSlug = Object.keys(publicDocToRequirement).find(
      slug => publicDocToRequirement[slug] === status.requirement.id
    );
    if (publicSlug && publicDocsBySlug[publicSlug]?.file_key) {
      // If we have a public doc, mark this requirement as COMPLIANT
      return {
        ...status,
        status: 'COMPLIANT' as const,
        publicDoc: publicDocsBySlug[publicSlug],
        lastUpdated: publicDocsBySlug[publicSlug].updated_at,
      };
    }
  }
  return { ...status, publicDoc: undefined };
});

// Recalculate compliance score based on enhanced statuses
const compliantCount = enhancedStatuses.filter((s) => s.status === 'COMPLIANT').length;
const partialCount = enhancedStatuses.filter((s) => s.status === 'PARTIAL').length;
const missingCount = enhancedStatuses.filter((s) => s.status === 'MISSING').length;
const totalCount = enhancedStatuses.length;
const complianceScore = totalCount > 0 ? Math.round((compliantCount / totalCount) * 100) : 0;

// Group by category
const categories = [
  { key: 'governing_docs', label: 'Governing Documents', icon: '📜' },
  { key: 'financial', label: 'Financial Documents', icon: '💰' },
  { key: 'meetings', label: 'Meetings & Notices', icon: '📅' },
  { key: 'contracts', label: 'Contracts & Bids', icon: '📝' },
  { key: 'insurance', label: 'Insurance', icon: '🛡️' },
  { key: 'other', label: 'Other', icon: '📋' },
];

const groupedStatuses = categories.map((cat) => ({
  ...cat,
  items: enhancedStatuses.filter(({ requirement }) => requirement.category === cat.key),
})).filter((cat) => cat.items.length > 0);

function formatDate(s: string | null): string {
  if (!s) return '';
  try {
    return new Date(s).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  } catch {
    return s;
  }
}

function getStatusBadge(status: string): { label: string; class: string } {
  switch (status) {
    case 'COMPLIANT':
      return { label: '✅ Posted', class: 'bg-green-100 text-green-800' };
    case 'PARTIAL':
      return { label: '⚠️ Needs Update', class: 'bg-amber-100 text-amber-800' };
    case 'MISSING':
      return { label: '❌ Not Posted', class: 'bg-red-100 text-red-800' };
    default:
      return { label: status, class: 'bg-gray-100 text-gray-800' };
  }
}

function getDocumentYear(doc: any): number {
  if (!doc?.document_date) return 0;
  try {
    return new Date(doc.document_date).getFullYear();
  } catch {
    return 0;
  }
}
---

<PortalLayout title="Compliance Documents | Member Portal | Crooked Lake Reserve HOA">
  <PortalPage
    currentPath="/portal/compliance"
    pageTitle="Florida HOA Compliance"
    userName={badges.displayName ?? undefined}
    userEmail={email}
    effectiveRole={effectiveRole}
    draftCount={badges.draftCount}
    role={effectiveRole}
    staffRole={role ?? ''}
    arbInReviewCount={badges.arbInReviewCount}
    vendorPendingCount={badges.vendorPendingCount}
    maintenanceOpenCount={badges.maintenanceOpenCount}
    meetingsRsvpCount={badges.meetingsRsvpCount}
    feedbackDueCount={badges.feedbackDueCount}
  >
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 mb-8">
      <!-- Header -->
      <div class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-heading font-bold text-clr-green mb-3">
          Florida HOA Compliance
        </h1>
        <p class="text-base text-gray-600">
          Florida Statute 720.303(4) requires homeowners associations to make specific documents available to members.
          This page shows all requirements and which documents have been posted.
        </p>
      </div>

      <!-- Overall Compliance Score -->
      <div class="mb-8 p-6 rounded-2xl bg-gradient-to-br from-clr-green/5 to-clr-green/10 border border-clr-green/20">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <div>
            <div class="text-base text-gray-700 mb-1">Overall Compliance</div>
            <div class="flex items-baseline gap-2">
              <div class="text-5xl font-bold text-clr-green">{complianceScore}%</div>
              <div class="text-base text-gray-600">
                {compliantCount} of {totalCount} requirements met
              </div>
            </div>
          </div>
          <!-- Progress Bar -->
          <div class="w-full md:w-64">
            <div class="h-3 bg-white rounded-full overflow-hidden border border-gray-200">
              <div
                class="h-full bg-clr-green transition-all duration-500"
                style={`width: ${complianceScore}%`}
              ></div>
            </div>
          </div>
        </div>

        <!-- Status Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
          <div class="p-4 rounded-xl bg-green-50 border border-green-200">
            <div class="text-2xl font-bold text-green-800 mb-1">{compliantCount}</div>
            <div class="text-sm font-medium text-green-700">✅ Posted & Current</div>
          </div>
          <div class="p-4 rounded-xl bg-amber-50 border border-amber-200">
            <div class="text-2xl font-bold text-amber-800 mb-1">{partialCount}</div>
            <div class="text-sm font-medium text-amber-700">⚠️ Needs Update</div>
          </div>
          <div class="p-4 rounded-xl bg-red-50 border border-red-200">
            <div class="text-2xl font-bold text-red-800 mb-1">{missingCount}</div>
            <div class="text-sm font-medium text-red-700">❌ Not Posted</div>
          </div>
        </div>
      </div>

      <!-- How This Score is Calculated -->
      <div class="mb-8 p-5 rounded-xl bg-blue-50 border border-blue-200">
        <h3 class="font-semibold text-base text-blue-900 mb-2">📊 How is the compliance percentage calculated?</h3>
        <p class="text-base text-blue-800">
          The score is calculated as: <strong>(Posted Documents ÷ Total Requirements) × 100</strong>
        </p>
        <p class="text-sm text-blue-700 mt-2">
          Current calculation: {compliantCount} compliant requirements ÷ {totalCount} total requirements = {complianceScore}%
        </p>
      </div>

      <!-- Requirements by Category -->
      <div class="space-y-6">
        {groupedStatuses.map((category) => (
          <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-2xl font-heading font-semibold text-clr-green mb-4 flex items-center gap-2">
              <span class="text-2xl">{category.icon}</span>
              {category.label}
              <span class="ml-2 text-sm font-normal text-gray-500">
                ({category.items.filter(i => i.status === 'COMPLIANT').length}/{category.items.length})
              </span>
            </h2>
            <div class="space-y-3">
              {category.items.map((item) => {
                const { requirement, status, document, publicDoc } = item;
                const effectiveDoc = document || publicDoc;
                const isFromPublicDocs = !document && !!publicDoc;
                const badge = getStatusBadge(status);

                return (
                  <div class={`p-4 rounded-xl border ${
                    status === 'COMPLIANT' ? 'border-green-200 bg-green-50/30' :
                    status === 'PARTIAL' ? 'border-amber-200 bg-amber-50/30' :
                    'border-red-200 bg-red-50/30'
                  } hover:shadow-sm transition-all`}>
                    <div class="flex items-start justify-between gap-4 flex-wrap">
                      <div class="flex-1 min-w-0">
                        <!-- Title and Status Badge -->
                        <div class="flex items-center gap-2 mb-2 flex-wrap">
                          <h3 class="font-semibold text-base text-gray-900">{requirement.title}</h3>
                          <span class={`px-2.5 py-1 rounded-lg text-xs font-semibold ${badge.class}`}>
                            {badge.label}
                          </span>
                          {requirement.requires_annual_update === 1 && status !== 'MISSING' && (
                            <span class="px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                              Annual Update Required
                            </span>
                          )}
                        </div>

                        <!-- Statute Reference -->
                        <p class="text-sm text-gray-600 mb-2">{requirement.statute_ref}</p>

                        <!-- Document Info (if available) -->
                        {effectiveDoc ? (
                          <div class="space-y-1">
                            <div class="flex items-center gap-2 text-sm text-gray-700">
                              <span>📄 {isFromPublicDocs ? publicDoc.title : document!.title}</span>
                              {document?.document_date && (
                                <span class="text-xs text-gray-500">
                                  ({getDocumentYear(document)} document)
                                </span>
                              )}
                            </div>
                            <div class="text-xs text-gray-500">
                              Last updated {formatDate(isFromPublicDocs ? publicDoc.updated_at : document!.uploaded_at)}
                            </div>
                            {status === 'PARTIAL' && (
                              <div class="text-sm text-amber-700 mt-2">
                                ⚠️ This document is from {getDocumentYear(document)} and needs to be updated for {new Date().getFullYear()}.
                              </div>
                            )}
                          </div>
                        ) : (
                          <div class="text-sm text-red-700">
                            ❌ This required document has not been posted yet. The Board is required to make this available per Florida law.
                          </div>
                        )}
                      </div>

                      <!-- Download Button (if document exists) -->
                      {effectiveDoc && (
                        <a
                          href={isFromPublicDocs
                            ? `/api/public-doc-file?slug=${publicDoc.slug}&v=${encodeURIComponent(publicDoc.updated_at || '')}`
                            : `/api/compliance/file/${document!.file_key}`
                          }
                          class="px-4 py-2 bg-clr-green text-white rounded-lg font-medium hover:brightness-110 text-sm whitespace-nowrap"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Download PDF
                        </a>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <!-- Information Footer -->
      <div class="mt-8 p-6 rounded-xl bg-gray-50 border border-gray-200">
        <h3 class="font-semibold text-base text-gray-900 mb-3">About Florida HOA Compliance</h3>
        <p class="text-base text-gray-700 mb-3">
          Florida Statute 720.303(4) requires homeowners associations to post specific official records on the association's website or make them digitally available to members. This includes:
        </p>
        <ul class="list-disc list-inside space-y-2 text-base text-gray-700 ml-2 mb-4">
          <li><strong>Governing Documents:</strong> Bylaws, covenants, articles of incorporation, rules and regulations</li>
          <li><strong>Financial Records:</strong> Current year budget, prior year financial reports, contracts over $10,000</li>
          <li><strong>Meeting Records:</strong> Board meeting notices (48 hours in advance), member meeting notices (14 days in advance)</li>
          <li><strong>Insurance:</strong> Current property and liability insurance policies</li>
        </ul>
        <p class="text-base text-gray-700 mb-2">
          <strong>What do the status badges mean?</strong>
        </p>
        <ul class="space-y-1.5 text-sm text-gray-700 ml-2 mb-4">
          <li><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-green-100 text-green-800 mr-2">✅ Posted</span> Document is available and current</li>
          <li><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-amber-100 text-amber-800 mr-2">⚠️ Needs Update</span> Document exists but requires annual update (e.g., budget, financial report)</li>
          <li><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-red-100 text-red-800 mr-2">❌ Not Posted</span> Required document is not yet available</li>
        </ul>
        <p class="text-base text-gray-600">
          <strong>Questions or concerns?</strong> If you notice a compliance gap, contact the Board at <a href="mailto:board@clrhoa.com" class="text-clr-green hover:underline">board@clrhoa.com</a>
        </p>
      </div>

      <!-- Quick Links -->
      <div class="mt-6 flex flex-wrap gap-4 justify-center text-base">
        <a href="/portal/documents" class="text-clr-green hover:underline">Member Documents</a>
        <span class="text-gray-400">•</span>
        <a href="/documents" class="text-clr-green hover:underline">Public Documents</a>
        <span class="text-gray-400">•</span>
        <a href="/portal/dashboard" class="text-clr-green hover:underline">Dashboard</a>
      </div>
    </div>
  </PortalPage>
</PortalLayout>
