---
/**
 * Unified audit log viewer — queries unified_audit_log with search + filters.
 * Board / admin only. Replaces the previous multi-table stitched view.
 */
export const prerender = false;

import { getAdminContext } from '../../../lib/board-context';
import { getPortalBadgeCounts } from '../../../lib/portal-badge-counts';
import { formatEasternDateTime } from '../../../lib/timezone';
import { queryUnifiedAuditLog, type UnifiedAuditRow } from '../../../lib/audit-log';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PortalPage from '../../../components/PortalPage.astro';
import ElevatedNav from '../../../components/ElevatedNav.astro';

const ctx = await getAdminContext(Astro);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { env, session, effectiveRole } = ctx;

const db = env?.DB;
const { email, role, name } = session;
const badges = await getPortalBadgeCounts(db, email, role, name);

// ─── Parse query params ───────────────────────────────────────────────────────
const sp = Astro.url.searchParams;
const PAGE_SIZES = [25, 50, 100, 250] as const;
const limit = PAGE_SIZES.includes(Number(sp.get('limit')) as typeof PAGE_SIZES[number])
  ? Number(sp.get('limit'))
  : 50;
const page   = Math.max(1, parseInt(sp.get('page') ?? '1', 10));
const offset = (page - 1) * limit;

const filters = {
  category:     sp.get('category')  || undefined,
  action:       sp.get('action')    || undefined,
  actorEmail:   sp.get('actor')     || undefined,
  targetEmail:  sp.get('target')    || undefined,
  resourceType: sp.get('rtype')     || undefined,
  resourceId:   sp.get('rid')       || undefined,
  outcome:      sp.get('outcome')   || undefined,
  search:       sp.get('q')         || undefined,
  dateFrom:     sp.get('from')      || undefined,
  dateTo:       sp.get('to')        || undefined,
  limit,
  offset,
};

// ─── CSV export ───────────────────────────────────────────────────────────────
if (sp.get('export') === 'csv' && db) {
  const exportFilters = { ...filters, limit: 500, offset: 0 };
  const { rows: csvRows } = await queryUnifiedAuditLog(db, exportFilters);
  const CSV_COLS = ['timestamp','category','action','action_label','actor_email','actor_role','ip_address','target_email','resource_type','resource_id','outcome','details'] as const;
  const escape = (v: unknown) => {
    if (v == null) return '';
    const s = String(v).replace(/"/g, '""');
    return /[",\n\r]/.test(s) ? `"${s}"` : s;
  };
  const header = CSV_COLS.join(',');
  const dataRows = csvRows.map(r => CSV_COLS.map(c => escape(r[c as keyof UnifiedAuditRow])).join(','));
  const csv = [header, ...dataRows].join('\r\n');
  return new Response(csv, {
    headers: {
      'Content-Type': 'text/csv; charset=utf-8',
      'Content-Disposition': `attachment; filename="audit-log-${new Date().toISOString().slice(0,10)}.csv"`,
    },
  });
}

const { rows, total } = db
  ? await queryUnifiedAuditLog(db, filters)
  : { rows: [] as UnifiedAuditRow[], total: 0 };

const totalPages = Math.ceil(total / limit);

// ─── Helpers ─────────────────────────────────────────────────────────────────
const CATEGORIES: { value: string; label: string }[] = [
  { value: 'auth',        label: 'Auth' },
  { value: 'user',        label: 'Users' },
  { value: 'arb',         label: 'ARB' },
  { value: 'directory',   label: 'Directory' },
  { value: 'vendor',      label: 'Vendors' },
  { value: 'compliance',  label: 'Compliance' },
  { value: 'financial',   label: 'Financial' },
  { value: 'document',    label: 'Documents' },
  { value: 'meeting',     label: 'Meetings' },
  { value: 'maintenance', label: 'Maintenance' },
  { value: 'feedback',    label: 'Feedback' },
  { value: 'system',      label: 'System' },
  { value: 'security',    label: 'Security' },
];

const CATEGORY_COLORS: Record<string, string> = {
  auth:        'bg-blue-100 text-blue-800',
  user:        'bg-purple-100 text-purple-800',
  arb:         'bg-green-100 text-green-800',
  directory:   'bg-yellow-100 text-yellow-800',
  vendor:      'bg-orange-100 text-orange-800',
  compliance:  'bg-teal-100 text-teal-800',
  financial:   'bg-red-100 text-red-800',
  document:    'bg-indigo-100 text-indigo-800',
  meeting:     'bg-cyan-100 text-cyan-800',
  maintenance: 'bg-slate-100 text-slate-800',
  feedback:    'bg-pink-100 text-pink-800',
  system:      'bg-gray-100 text-gray-700',
  security:    'bg-red-200 text-red-900',
};

const OUTCOME_COLORS: Record<string, string> = {
  success: 'bg-green-100 text-green-800',
  failure: 'bg-red-100 text-red-800',
  partial: 'bg-amber-100 text-amber-800',
};

function catColor(cat: string) { return CATEGORY_COLORS[cat] ?? 'bg-gray-100 text-gray-700'; }
function outcomeColor(o: string) { return OUTCOME_COLORS[o] ?? 'bg-gray-100 text-gray-700'; }

function filterUrl(overrides: Record<string, string | number | undefined>): string {
  const u = new URL(Astro.url);
  const next = { ...Object.fromEntries(u.searchParams), ...overrides };
  const out = new URLSearchParams();
  for (const [k, v] of Object.entries(next)) {
    if (v !== undefined && v !== '' && v !== null) out.set(k, String(v));
  }
  // Reset to page 1 when any filter changes (except page itself)
  if (!('page' in overrides)) out.delete('page');
  return `${u.pathname}?${out.toString()}`;
}

function pageUrl(p: number) { return filterUrl({ page: p }); }

function fmt(s: string | null) {
  return formatEasternDateTime(s) === '—' ? '—' : formatEasternDateTime(s);
}

// For CSV export — build a query-string-only URL
const exportUrl = (() => {
  const u = new URL(Astro.url);
  u.searchParams.set('export', 'csv');
  u.searchParams.delete('page');
  u.searchParams.set('limit', '500');
  return u.pathname + u.search;
})();
---

<PortalLayout title="Audit Log | Board | Member Portal | Crooked Lake Reserve HOA">
  <PortalPage
    currentPath="/portal/board/audit-logs"
    pageTitle="Audit Log"
    userName={badges.displayName ?? undefined}
    userEmail={email}
    effectiveRole={effectiveRole}
    draftCount={badges.draftCount}
    role={effectiveRole}
    staffRole={role ?? ''}
    arbInReviewCount={badges.arbInReviewCount}
    vendorPendingCount={badges.vendorPendingCount}
    maintenanceOpenCount={badges.maintenanceOpenCount}
    meetingsRsvpCount={badges.meetingsRsvpCount}
    feedbackDueCount={badges.feedbackDueCount}
    libraryItemCount={badges.libraryItemCount}
  >
    <div class="space-y-6">
      <!-- Header -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="flex items-center justify-between flex-wrap gap-4 mb-2">
          <div>
            <h1 class="text-2xl font-heading font-bold text-clr-green">Audit Log</h1>
            <p class="text-sm text-gray-500 mt-1">
              All system activity — {total.toLocaleString()} event{total !== 1 ? 's' : ''} matching current filters.
              Financial and compliance records retained 7 years per FL §720.303.
            </p>
          </div>
          <div class="flex items-center gap-3">
            <a
              href={exportUrl}
              class="inline-flex items-center gap-2 px-4 py-2 bg-clr-green text-white rounded-lg text-sm font-medium hover:brightness-110"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              Export CSV
            </a>
            <a href="/portal/board/audit-logs" class="text-sm text-gray-500 hover:text-gray-700 underline">Clear filters</a>
          </div>
        </div>

        <!-- ElevatedNav for board/admin actions -->
        <ElevatedNav persona="board" currentPath="/portal/board/audit-logs" effectiveRole={effectiveRole} user={{ email, role: role ?? '' }} session={session} />
      </div>

      <!-- Filters -->
      <form method="get" action="/portal/board/audit-logs" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
          <!-- Full-text search -->
          <div class="lg:col-span-2">
            <label class="block text-xs font-semibold text-gray-600 mb-1">Search</label>
            <input
              type="text"
              name="q"
              value={sp.get('q') ?? ''}
              placeholder="Email, action, resource ID, details…"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green focus:border-clr-green"
            />
          </div>

          <!-- Category -->
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Category</label>
            <select name="category" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green">
              <option value="">All categories</option>
              {CATEGORIES.map(c => (
                <option value={c.value} selected={sp.get('category') === c.value}>{c.label}</option>
              ))}
            </select>
          </div>

          <!-- Outcome -->
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Outcome</label>
            <select name="outcome" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green">
              <option value="">All outcomes</option>
              <option value="success" selected={sp.get('outcome') === 'success'}>Success</option>
              <option value="failure" selected={sp.get('outcome') === 'failure'}>Failure</option>
              <option value="partial" selected={sp.get('outcome') === 'partial'}>Partial</option>
            </select>
          </div>

          <!-- Actor email -->
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Actor (email)</label>
            <input
              type="text"
              name="actor"
              value={sp.get('actor') ?? ''}
              placeholder="who performed the action"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green focus:border-clr-green"
            />
          </div>

          <!-- Target email -->
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Target (email)</label>
            <input
              type="text"
              name="target"
              value={sp.get('target') ?? ''}
              placeholder="who was affected"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green focus:border-clr-green"
            />
          </div>

          <!-- Date from -->
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">From date</label>
            <input
              type="date"
              name="from"
              value={sp.get('from') ?? ''}
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green focus:border-clr-green"
            />
          </div>

          <!-- Date to -->
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">To date</label>
            <input
              type="date"
              name="to"
              value={sp.get('to') ?? ''}
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green focus:border-clr-green"
            />
          </div>

          <!-- Resource type -->
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Resource type</label>
            <input
              type="text"
              name="rtype"
              value={sp.get('rtype') ?? ''}
              placeholder="e.g. arb_request, payment"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green focus:border-clr-green"
            />
          </div>

          <!-- Resource ID -->
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Resource ID</label>
            <input
              type="text"
              name="rid"
              value={sp.get('rid') ?? ''}
              placeholder="exact ID of the resource"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green focus:border-clr-green"
            />
          </div>

          <!-- Rows per page -->
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Rows per page</label>
            <select name="limit" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-clr-green">
              {PAGE_SIZES.map(n => (
                <option value={n} selected={limit === n}>{n}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <button type="submit" class="px-5 py-2 bg-clr-green text-white rounded-lg text-sm font-medium hover:brightness-110">
            Apply filters
          </button>
          <a href="/portal/board/audit-logs" class="px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-600 hover:bg-gray-50">
            Reset
          </a>
        </div>
      </form>

      <!-- Active filter chips -->
      {(filters.category || filters.actorEmail || filters.targetEmail || filters.outcome || filters.search || filters.dateFrom || filters.dateTo || filters.resourceId) && (
        <div class="flex flex-wrap gap-2 items-center">
          <span class="text-xs font-semibold text-gray-500">Active filters:</span>
          {filters.search      && <a href={filterUrl({ q: undefined })}       class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs hover:bg-gray-200">Search: "{filters.search}" ×</a>}
          {filters.category    && <a href={filterUrl({ category: undefined })} class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs hover:bg-gray-200">Category: {filters.category} ×</a>}
          {filters.actorEmail  && <a href={filterUrl({ actor: undefined })}    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs hover:bg-gray-200">Actor: {filters.actorEmail} ×</a>}
          {filters.targetEmail && <a href={filterUrl({ target: undefined })}   class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs hover:bg-gray-200">Target: {filters.targetEmail} ×</a>}
          {filters.outcome     && <a href={filterUrl({ outcome: undefined })}  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs hover:bg-gray-200">Outcome: {filters.outcome} ×</a>}
          {filters.dateFrom    && <a href={filterUrl({ from: undefined })}     class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs hover:bg-gray-200">From: {filters.dateFrom} ×</a>}
          {filters.dateTo      && <a href={filterUrl({ to: undefined })}       class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs hover:bg-gray-200">To: {filters.dateTo} ×</a>}
          {filters.resourceId  && <a href={filterUrl({ rid: undefined })}      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs hover:bg-gray-200">Resource: {filters.resourceId} ×</a>}
        </div>
      )}

      <!-- Results table -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        {rows.length === 0 ? (
          <div class="p-12 text-center text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <p class="font-medium">No events found</p>
            <p class="text-sm mt-1">
              {Object.values(filters).some(Boolean)
                ? 'Try adjusting your filters or clearing them.'
                : 'Events will appear here as users interact with the portal.'}
            </p>
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-100 text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Timestamp</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Category</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Action</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Actor</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Target / Resource</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Outcome</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Details</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50">
                {rows.map((row) => {
                  const details = row.details ? (() => { try { return JSON.parse(row.details!); } catch { return null; } })() : null;
                  return (
                    <tr class="hover:bg-gray-50 transition-colors">
                      <!-- Timestamp -->
                      <td class="px-4 py-3 whitespace-nowrap text-gray-500 text-xs font-mono">
                        {fmt(row.timestamp)}
                      </td>

                      <!-- Category badge -->
                      <td class="px-4 py-3 whitespace-nowrap">
                        <a
                          href={filterUrl({ category: row.category })}
                          class={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold ${catColor(row.category)} hover:opacity-80`}
                          title="Filter by this category"
                        >
                          {row.category}
                        </a>
                      </td>

                      <!-- Action -->
                      <td class="px-4 py-3">
                        <div class="font-medium text-gray-800">
                          {row.action_label || row.action.replace(/_/g, ' ')}
                        </div>
                        <div class="text-xs text-gray-400 font-mono mt-0.5">{row.action}</div>
                      </td>

                      <!-- Actor -->
                      <td class="px-4 py-3">
                        <a
                          href={filterUrl({ actor: row.actor_email })}
                          class="text-clr-green hover:underline text-xs"
                          title="Filter by this actor"
                        >
                          {row.actor_email}
                        </a>
                        {row.actor_role && (
                          <div class="text-xs text-gray-400 mt-0.5">{row.actor_role}</div>
                        )}
                        {row.ip_address && (
                          <div class="text-xs text-gray-300 font-mono mt-0.5">{row.ip_address}</div>
                        )}
                      </td>

                      <!-- Target / Resource -->
                      <td class="px-4 py-3">
                        {row.target_email && (
                          <a
                            href={filterUrl({ target: row.target_email })}
                            class="text-clr-green hover:underline text-xs block"
                            title="Filter by this target"
                          >
                            {row.target_email}
                          </a>
                        )}
                        {(row.resource_type || row.resource_id) && (
                          <div class="text-xs text-gray-400 mt-0.5">
                            {row.resource_type && <span class="font-mono">{row.resource_type}</span>}
                            {row.resource_id && (
                              <a
                                href={filterUrl({ rid: row.resource_id, rtype: row.resource_type ?? undefined })}
                                class="ml-1 font-mono text-gray-500 hover:text-clr-green hover:underline"
                                title="Filter by this resource ID"
                              >
                                #{row.resource_id.length > 12 ? row.resource_id.slice(0, 12) + '…' : row.resource_id}
                              </a>
                            )}
                          </div>
                        )}
                      </td>

                      <!-- Outcome -->
                      <td class="px-4 py-3 whitespace-nowrap">
                        <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold ${outcomeColor(row.outcome)}`}>
                          {row.outcome}
                        </span>
                      </td>

                      <!-- Details (expandable) -->
                      <td class="px-4 py-3 max-w-xs">
                        {details ? (
                          <details class="cursor-pointer">
                            <summary class="text-xs text-gray-500 hover:text-gray-700 select-none list-none flex items-center gap-1">
                              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                              View details
                            </summary>
                            <div class="mt-2 text-xs font-mono bg-gray-50 rounded p-2 whitespace-pre-wrap break-all max-h-40 overflow-y-auto border border-gray-100">
                              {JSON.stringify(details, null, 2)}
                            </div>
                          </details>
                        ) : (
                          <span class="text-gray-300 text-xs">—</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}

        <!-- Pagination -->
        {totalPages > 1 && (
          <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between flex-wrap gap-4">
            <p class="text-sm text-gray-500">
              Showing {offset + 1}–{Math.min(offset + limit, total)} of {total.toLocaleString()} events
            </p>
            <div class="flex items-center gap-1">
              {page > 1 && (
                <a href={pageUrl(1)} class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-gray-600 hover:bg-gray-50">«</a>
              )}
              {page > 1 && (
                <a href={pageUrl(page - 1)} class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-gray-600 hover:bg-gray-50">‹ Prev</a>
              )}

              {/* Show up to 5 page numbers around current page */}
              {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                const start = Math.max(1, Math.min(page - 2, totalPages - 4));
                return start + i;
              }).filter(p => p >= 1 && p <= totalPages).map(p => (
                <a
                  href={pageUrl(p)}
                  class={`px-3 py-1.5 rounded-lg border text-xs font-medium ${p === page ? 'bg-clr-green text-white border-clr-green' : 'border-gray-200 text-gray-600 hover:bg-gray-50'}`}
                >
                  {p}
                </a>
              ))}

              {page < totalPages && (
                <a href={pageUrl(page + 1)} class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-gray-600 hover:bg-gray-50">Next ›</a>
              )}
              {page < totalPages && (
                <a href={pageUrl(totalPages)} class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-gray-600 hover:bg-gray-50">»</a>
              )}
            </div>
          </div>
        )}
      </div>

      <!-- Category quick-filter cards -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
        <h2 class="text-sm font-semibold text-gray-700 mb-3">Filter by category</h2>
        <div class="flex flex-wrap gap-2">
          {CATEGORIES.map(c => (
            <a
              href={filterUrl({ category: filters.category === c.value ? undefined : c.value })}
              class={`px-3 py-1.5 rounded-full text-xs font-semibold border transition-all ${
                filters.category === c.value
                  ? `${catColor(c.value)} border-current`
                  : 'border-gray-200 text-gray-600 hover:bg-gray-50'
              }`}
            >
              {c.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Retention policy note -->
      <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 text-sm text-blue-800">
        <span class="font-semibold">Record retention:</span> Financial, compliance, ARB, and document events are retained 7 years per FL §720.303.
        Auth and system events are retained 1 year. Security events are retained 2 years.
        Events older than their retention period are eligible for scheduled cleanup.
      </div>
    </div>
  </PortalPage>
