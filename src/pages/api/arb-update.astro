---
/**
 * POST /api/arb-update — owner can update a pending ARB request (applicant_name, phone, property_address, application_type, description).
 * Form: request_id, applicant_name, phone, property_address, application_type (multiple), description.
 */
export const prerender = false;

import { verifyCsrfToken, verifyOrigin } from '../../lib/auth';
import { createLogger, maskRequestId } from '../../lib/logging';
import { checkRateLimit, getRateLimitConfig } from '../../lib/rate-limit';
import { getSecurityMonitor } from '../../lib/monitoring';
import { updateArbRequestByOwner } from '../../lib/arb-db';
import { requireArbRequestOwner } from '../../lib/access-control';

const runtime = Astro.locals.runtime;
const env = runtime?.env;
const logger = createLogger({ endpoint: 'arb-update' });
const user = Astro.locals.user;
const session = Astro.locals.session;

if (!session || !user) {
  return new Response(JSON.stringify({ error: 'Unauthorized' }), {
    status: 401,
    headers: { 'Content-Type': 'application/json' },
  });
}

// CSRF protection: verify origin
const origin = Astro.request.headers.get('origin');
const referer = Astro.request.headers.get('referer');
const expectedOrigin = Astro.url.origin;
if (!verifyOrigin(origin, referer, expectedOrigin)) {
  return new Response(JSON.stringify({ error: 'Invalid origin. Request blocked for security.' }), {
    status: 403,
    headers: { 'Content-Type': 'application/json' },
  });
}

if (Astro.request.method !== 'POST') {
  return new Response(JSON.stringify({ error: 'Method not allowed' }), {
    status: 405,
    headers: { 'Content-Type': 'application/json' },
  });
}

const db = env?.DB;
if (!db) {
  return new Response(JSON.stringify({ error: 'Server configuration error' }), {
    status: 503,
    headers: { 'Content-Type': 'application/json' },
  });
}

try {
  const formData = await Astro.request.formData();

  // CSRF token verification
  const csrfToken = formData.get('csrf_token') as string | null;
  if (!verifyCsrfToken(session, csrfToken)) {
    logger.warn('CSRF token verification failed', { user: user.email });
    return new Response(
      JSON.stringify({ error: 'Invalid security token. Please refresh the page and try again.' }),
      { status: 403, headers: { 'Content-Type': 'application/json' } }
    );
  }

  const requestId = (formData.get('request_id') as string)?.trim();
  if (!requestId) {
    logger.warn('Missing request_id', { user: user.email });
    return new Response(JSON.stringify({ error: 'Request ID is required.' }), {
      status: 400,
      headers: { 'Content-Type': 'application/json' },
    });
  }

  logger.info('ARB update attempt', { requestId: maskRequestId(requestId), user: user.email });

  const ownerCheck = await requireArbRequestOwner(db, requestId, user, { requirePending: true });
  if ('response' in ownerCheck) {
    logger.warn('Owner check failed', { requestId: maskRequestId(requestId), user: user.email });
    return ownerCheck.response;
  }
  const { request } = ownerCheck;

  const description = (formData.get('description') as string)?.trim();
  if (!description) {
    logger.warn('Missing description', { requestId: maskRequestId(requestId), user: user.email });
    return new Response(JSON.stringify({ error: 'Description is required.' }), {
      status: 400,
      headers: { 'Content-Type': 'application/json' },
    });
  }

  const applicantName = (formData.get('applicant_name') as string)?.trim() || null;
  const phone = (formData.get('phone') as string)?.trim() || null;
  const propertyAddress = (formData.get('property_address') as string)?.trim() || null;

  if (!applicantName) {
    logger.warn('Missing applicant_name', { requestId: maskRequestId(requestId), user: user.email });
    return new Response(JSON.stringify({ error: "Applicant's name is required." }), {
      status: 400,
      headers: { 'Content-Type': 'application/json' },
    });
  }
  if (!phone) {
    logger.warn('Missing phone', { requestId: maskRequestId(requestId), user: user.email });
    return new Response(JSON.stringify({ error: 'Phone number is required.' }), {
      status: 400,
      headers: { 'Content-Type': 'application/json' },
    });
  }
  if (!propertyAddress) {
    logger.warn('Missing property_address', { requestId: maskRequestId(requestId), user: user.email });
    return new Response(JSON.stringify({ error: 'Property address is required.' }), {
      status: 400,
      headers: { 'Content-Type': 'application/json' },
    });
  }
  const types = formData.getAll('application_type');
  const applicationType = Array.isArray(types) && types.length > 0
    ? types.map((t) => String(t).trim()).filter(Boolean).join(', ')
    : null;
  const ownerNotes = (formData.get('owner_notes') as string)?.trim() || null;

  logger.info('Updating ARB request', {
    requestId: maskRequestId(requestId),
    user: user.email,
    hasApplicantName: !!applicantName,
    hasPhone: !!phone,
    hasPropertyAddress: !!propertyAddress,
    hasApplicationType: !!applicationType,
    hasDescription: !!description
  });

  const updated = await updateArbRequestByOwner(db, requestId, request.owner_email, {
    applicantName,
    phone,
    propertyAddress,
    applicationType,
    description,
    ownerNotes,
  });

  if (!updated) {
    logger.warn('Update returned false', { requestId: maskRequestId(requestId), user: user.email });
    return new Response(
      JSON.stringify({ error: 'Request not found, already decided, or you do not have access to this request.' }),
      { status: 404, headers: { 'Content-Type': 'application/json' } }
    );
  }

  logger.info('ARB request updated successfully', { requestId: maskRequestId(requestId), user: user.email });
  return new Response(
    JSON.stringify({ success: true, message: 'Your request has been updated.' }),
    { status: 200, headers: { 'Content-Type': 'application/json' } }
  );
} catch (e) {
  const errorMessage = e instanceof Error ? e.message : String(e);
  const errorStack = e instanceof Error ? e.stack : undefined;
  logger.error('ARB update failed with exception', {
    error: errorMessage,
    stack: errorStack,
    user: user.email
  });
  return new Response(
    JSON.stringify({ error: 'Update failed. Please try again.' }),
    { status: 500, headers: { 'Content-Type': 'application/json' } }
  );
}
---
